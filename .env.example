# Modelo para desenvolvimento local. Copie para .env somente se ele ainda não existir.
# Nunca use credenciais de produção para testes ou dados de demonstração.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql://ija_local:troque-a-senha@localhost:5432/ija_system_local

# Enable only after applying the Central TI migration in the authorized environment.
# Stores proposed configurations; current access rules remain unchanged.
CENTRAL_TI_ENABLED=0
# Enable only after installing and validating the Central TI tables.
CENTRAL_TI_ENFORCE_PERMISSIONS=0
FLASK_DEBUG=1
FLASK_USE_RELOADER=0

# Valores do Config. run.py usa 480 minutos em DEBUG se a variável não existir.
# Os controles de sessão/senha e CSRF são opt-in e exigem SECRET_KEY estável.
SECURITY_CONTROLS_ENABLED=0
CSRF_PROTECTION_ENABLED=0
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_MAX_LIFETIME_HOURS=0
PASSWORD_MIN_LENGTH=9
PASSWORD_REQUIRE_UPPERCASE=1
PASSWORD_REQUIRE_LOWERCASE=1
PASSWORD_REQUIRE_DIGIT=1
PASSWORD_REQUIRE_SYMBOL=1
# Somente DEBUG/TESTING, de 5 a 59 segundos; deixe comentado no uso normal.
# SESSION_IDLE_TIMEOUT_SECONDS=30

USER_PRESENCE_UPDATE_INTERVAL_SECONDS=300
AUDIT_RETENTION_MAX_RECORDS=15000
CSS_BUNDLE_AUTO_BUILD=1

# Prévia provisória de focal/LIRAa, sem gravação no banco. Ative só para validação.
# Guia: docs/vigilancia-validacao-inicial.md
VIGILANCIA_PREVIEW_ENABLED=0
# Carga persistida Focal/LIRAa no PostgreSQL configurado em DATABASE_URL.
# Aplicar a migração antes de habilitar. Guia: docs/vigilancia-carga-campo.md
VIGILANCIA_IMPORT_ENABLED=0
# Consulta autenticada de indicadores públicos de dengue, zika e chikungunya (CONDOMAR e São Paulo).
SINAN_ENABLED=1
SINAN_IMPORT_ENABLED=1
# Uses the application's database (PostgreSQL/Neon). SQLite is explicit legacy/local use.
SINAN_STORAGE_BACKEND=database
# Legacy source for transfer, or path when SINAN_STORAGE_BACKEND=sqlite.
SINAN_STORAGE_PATH=

# Integrações opcionais; preencha apenas as utilizadas no ambiente local.
KEY_API_GOOGLE_MAPS=
GOOGLE_MAPS_KEY_BACK=
CORREIOS_CEP_TOKEN=
# CORREIOS_API_TOKEN é alternativa a CORREIOS_CEP_TOKEN.
CORREIOS_CEP_BASE_URL=https://api.correios.com.br/cep

SKYBOX_WEBDAV_URL=
SKYBOX_USERNAME=
SKYBOX_APP_PASSWORD=
SKYBOX_BASE_DIR="dados ordens de serviço"

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
PROJECT_NAME=ija-system
APP_ENV=local

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

INFODENGUE_GEOCODE=3550308
INFODENGUE_CITY="São Paulo"
INFODENGUE_DISEASE=dengue
INFODENGUE_LOOKBACK_WEEKS=8

# Rastreamento OLLOG / RedGPS. Credenciais usadas somente no servidor.
REDGPS_BASE_URL=https://api.service24gps.com/api/v1
REDGPS_API_KEY=
REDGPS_USERNAME=
REDGPS_PASSWORD=
REDGPS_SYNC_ENABLED=false
REDGPS_POLL_INTERVAL_SECONDS=60

# Opções avançadas de WebDAV, vídeo, PDF, Gunicorn e watchdog: docs/configuracao.md.
# APP_ENV só nomeia backups; não desliga o agendador nem ativa/desativa DEBUG.

# Proteção de login: aplicar a migração antes de iniciar esta versão.
LOGIN_PROTECTION_ENABLED=1
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Redes dos proxies reais, não os IPs dos usuários. Vazio ignora X-Forwarded-For.
LOGIN_TRUSTED_PROXY_CIDRS=
